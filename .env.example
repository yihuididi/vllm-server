# Pin a tested release tag or digest for reproducible deployments.
VLLM_IMAGE=vllm/vllm-openai:latest
MODEL_NAME=Qwen/Qwen3-8B

# Comma-separated host GPU indices, without spaces. Select exactly TP GPUs.
GPU_IDS=0
TENSOR_PARALLEL_SIZE=1

# Host port; the container always listens on 8000.
PORT=8000

# Optional for public models; required for gated/private models.
HF_TOKEN=

# Passed as CLI arguments, overriding the defaults in configs/vllm.yaml.
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
